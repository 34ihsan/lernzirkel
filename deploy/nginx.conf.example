# /etc/nginx/sites-available/lernzirkel-online.de
# Kurulum: deploy/setup-vps.sh bu dosyayı oraya kopyalayıp domain'i otomatik yerleştirir.
# certbot --nginx komutu çalıştırıldıktan sonra bu dosyanın SSL bloğu certbot tarafından
# otomatik güncellenir (443 server bloğu + redirect eklenir) — ilk kurulumda sadece 80 vardır.

upstream lernzirkel_app {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name lernzirkel-online.de www.lernzirkel-online.de;

    client_max_body_size 15M; # /api/upload 10MB limitinin biraz üstü

    # Let's Encrypt ACME challenge (certbot --nginx bunu otomatik yönetir)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Next.js statik build çıktısı — immutable, uzun cache
    location /_next/static/ {
        alias /var/www/lernzirkel/.next/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Kullanıcı yüklemeleri (public/uploads) — Nginx'ten direkt servis edilir, Node'a gitmez
    location /uploads/ {
        alias /var/www/lernzirkel/public/uploads/;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location / {
        proxy_pass http://lernzirkel_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Güvenlik başlıkları (proxy.ts'teki uygulama seviyesi başlıklara ek, defense-in-depth)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
