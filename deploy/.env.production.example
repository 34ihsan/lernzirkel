# /var/www/lernzirkel/.env.production — gerçek değerlerle doldurup sunucuya kopyalayın.
# Bu dosya ASLA git'e commit edilmemeli.

# setup-vps.sh'te oluşturulan Postgres kullanıcı/şifresiyle:
DATABASE_URL="postgresql://lernzirkel:<SIFRE>@localhost:5432/lernzirkel"

# Admin oturum imzalama anahtarı — en az 32 byte rastgele değer:
#   openssl rand -base64 32
AUTH_SECRET="<buraya-rastgele-uretilen-deger>"

# Kalıcı yükleme dizini (deploy sırasında .next yeniden build edilse de kaybolmaz)
UPLOADS_DIR="/var/www/lernzirkel/public/uploads"

# Cron endpoint'lerini korumak için — en az 32 byte rastgele değer:
#   openssl rand -hex 32
CRON_SECRET="<buraya-rastgele-uretilen-deger>"

# E-posta (Resend) — tanımlı değilse mock modda kalır, hiçbir şey kırılmaz
RESEND_API_KEY=""
EMAIL_FROM="Lernzirkel <info@lernzirkel-ludwigshafen.de>"

# E-posta teslimat takibi (opsiyonel) — Resend Dashboard → Webhooks → Add Endpoint
#   URL: https://lernzirkel-ludwigshafen.de/api/webhooks/resend
#   Events: email.delivered, email.bounced, email.complained, email.delivery_delayed
RESEND_WEBHOOK_SECRET=""

# CAPTCHA (Cloudflare Turnstile) — tanımlı değilse CAPTCHA devre dışı kalır
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

NODE_ENV="production"
