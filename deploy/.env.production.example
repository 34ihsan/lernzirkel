# /opt/sites/lernzirkel/.env.production — gerçek değerlerle doldurup sunucuya kopyalayın,
# chmod 600 verin. Bu dosya ASLA git'e commit edilmemeli.
#
# Bu dosya iki amaçla kullanılır:
#   1) `docker compose --env-file .env.production ...` ile docker-compose.yml'deki
#      ${SITE_HOST} gibi değerlerin doldurulması (yalnızca derleme/compose zamanı)
#   2) `env_file:` ile konteyner içine çalışma zamanı ortam değişkeni olarak enjekte edilmesi
#
# Platformun ortak sırları (Postgres admin, Cloudflare API token) burada DEĞİL,
# sunucuda /opt/platform/.env içinde durur.

# ── 1. Traefik yönlendirmesi (yalnızca compose/Traefik okur, uygulama kodu okumaz) ──
SITE_HOST="www.lernzirkel-ludwigshafen.de"       # canonical (bu host'a TLS sertifikası çıkar)
SITE_HOST_ALT="lernzirkel-ludwigshafen.de"        # apex; docker-compose.yml bunu www'ye 301 yönlendirir

# ── 2. Veritabanı (zorunlu) ──────────────────────────────────────────────────
# Üretmek için sunucuda: cd /opt/platform && bash scripts/create-site-db.sh lernzirkel
# Çıktıdaki DATABASE_URL'i buraya yapıştırın; host adı "postgres" olmalı (localhost DEĞİL —
# platformun data ağındaki Postgres container'ının adı budur).
DATABASE_URL="postgresql://site_lernzirkel:<SIFRE>@postgres:5432/site_lernzirkel?schema=public&connection_limit=10"

# ── 3. Admin oturum imzalama anahtarı (zorunlu) ──────────────────────────────
# Üretmek için: openssl rand -base64 32
AUTH_SECRET="<buraya-rastgele-uretilen-deger>"

# ── 4. Cron endpoint koruması (zorunlu — /api/cron/* bu secret'ı ister) ──────
# Üretmek için: openssl rand -hex 32
CRON_SECRET="<buraya-rastgele-uretilen-deger>"

# ── 5. Site URL'i [BUILD] — derleme anında istemci paketine gömülür ──────────
# docker-compose.yml build.args ile Docker build ARG'ı olarak da geçirilir; bu dosyadaki
# değer hem derleme hem çalışma zamanı için tek doğruluk kaynağıdır.
NEXT_PUBLIC_SITE_URL="https://www.lernzirkel-ludwigshafen.de"

# ── 6. E-posta (Resend) — tanımlı değilse mock modda kalır, hiçbir şey kırılmaz ──
RESEND_API_KEY=""
EMAIL_FROM="Lernzirkel Ludwigshafen e.V. <info@lernzirkel-ludwigshafen.de>"

# E-posta teslimat takibi (opsiyonel) — Resend Dashboard → Webhooks → Add Endpoint
#   URL: https://www.lernzirkel-ludwigshafen.de/api/webhooks/resend
#   Events: email.delivered, email.bounced, email.complained, email.delivery_delayed
RESEND_WEBHOOK_SECRET=""

# ── 7. CAPTCHA (Cloudflare Turnstile) — tanımlı değilse CAPTCHA devre dışı kalır ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""     # [BUILD] derleme anında gömülür
TURNSTILE_SECRET_KEY=""

# UPLOADS_DIR ve NODE_ENV burada YOK: Dockerfile/docker-compose.yml zaten sabitliyor
# (public/uploads bir Docker volume, NODE_ENV=production imajda).
