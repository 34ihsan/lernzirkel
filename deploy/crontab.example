# deploy kullanıcısının crontab'ı: crontab -u deploy -e ile düzenlenir.
# CRON_SECRET değerini .env.production'dakiyle aynı yapın.
# Uygulama Docker'da çalışıyor (bkz. DEPLOYMENT.md); bu görevler host'tan genel ağ
# üzerinden siteye curl atar, konteynerin içine girmesi gerekmez.

# Zamanlanmış içerik yayınlama (publishAt geçmiş Page/Article) — her 15 dakikada
*/15 * * * * curl -fsS -X GET -H "Authorization: Bearer __CRON_SECRET__" https://www.lernzirkel-ludwigshafen.de/api/cron/publish >> /var/log/lernzirkel/cron.log 2>&1

# İçerik tablolarının JSON anlık görüntüsü (ek yedek — asıl DB yedeği platform/scripts/
# backup-restic.sh ile alınır, bkz. DEPLOYMENT.md) — her gün 04:00
0 4 * * * mkdir -p /home/deploy/backups/lernzirkel && curl -fsS -o "/home/deploy/backups/lernzirkel/db-backup-$(date +%F).json" -H "Authorization: Bearer __CRON_SECRET__" https://www.lernzirkel-ludwigshafen.de/api/cron/db-backup >> /var/log/lernzirkel/cron.log 2>&1

# Kurs-sonu anonim anket: biten kurslara davet, yanıtsızlara hatırlatma, süresi
# geçenleri kapatma ve eski davet kayıtlarının GDPR temizliği — her gün 08:00
0 8 * * * curl -fsS -X GET -H "Authorization: Bearer __CRON_SECRET__" https://www.lernzirkel-ludwigshafen.de/api/cron/survey-dispatch >> /var/log/lernzirkel/cron.log 2>&1
