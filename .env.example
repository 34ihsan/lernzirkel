# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri kendi ortamınıza göre doldurun:
#   cp .env.example .env

# ─── Veritabanı (zorunlu) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lernzirkel_next?schema=public"

# ─── Shadow database (zorunlu — `prisma migrate dev`/`diff` bunu kullanır) ──
# Prisma'nın migration'ları denemek için kullandığı, geçici/boş bir veritabanı.
# Aynı Postgres sunucusunda farklı bir DB adıyla yeterli, Prisma onu otomatik
# oluşturup siler — elle bir şey oluşturmanıza gerek yok, sadece aynı kullanıcı/
# şifreyle, DATABASE_URL'den farklı bir DB adı verin.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lernzirkel_next_shadow?schema=public"

# ─── Admin oturum imzalama anahtarı (zorunlu) ───────────────────────────────
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""

# ─── Cron endpoint koruması (zorunlu — /api/cron/* bu secret'ı ister) ───────
# Üretmek için: openssl rand -hex 32
CRON_SECRET=""

# ─── Site URL'i (e-posta içindeki linkler, SEO meta etiketleri için) ────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── E-posta (Resend) ────────────────────────────────────────────────────────
# Boş bırakılırsa sistem "mock mod"da çalışır: gerçek mail gönderilmez, içerik
# sadece terminale yazılır — hiçbir şey kırılmaz. resend.com'dan alınır.
RESEND_API_KEY=""
EMAIL_FROM="Lernzirkel Ludwigshafen e.V. <info@lernzirkel-ludwigshafen.de>"

# ─── E-posta teslimat takibi (Resend Webhook) — opsiyonel ───────────────────
# Tanımlı değilse anket davetleri sadece "Gönderildi" diye işaretlenir (Resend'in isteği
# kabul ettiği anlamına gelir, posta kutusuna ULAŞTIĞI anlamına gelmez). Bu değeri
# eklerseniz admin panelinde gerçek "Teslim edildi / Geri döndü / Spam'e düştü" durumu
# görünür. Kurulum: Resend Dashboard → Webhooks → Add Endpoint
#   URL: https://<domain>/api/webhooks/resend
#   Events: email.delivered, email.bounced, email.complained, email.delivery_delayed
#   Oluşturulan "Signing Secret" değerini buraya yapıştırın (whsec_... ile başlar).
RESEND_WEBHOOK_SECRET=""

# ─── CAPTCHA (Cloudflare Turnstile) — opsiyonel ─────────────────────────────
# Boş bırakılırsa CAPTCHA kontrolü devre dışı kalır. dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Yükleme dizini — opsiyonel (VPS'te kalıcı bir yol için) ────────────────
# Boş bırakılırsa public/uploads kullanılır.
# UPLOADS_DIR="/var/www/lernzirkel/public/uploads"

# ─── Depo doküman dizini — opsiyonel (VPS'te kalıcı bir yol için) ───────────
# Boş bırakılırsa proje köküne göre ./depot-storage kullanılır. UPLOADS_DIR'den
# BİLİNÇLİ OLARAK AYRI: bu klasör public/ altında DEĞİL, Next.js hiç statik
# servis etmiyor — dosyalara sadece /api/depo/download/[id] üzerinden, yetki
# kontrolünden geçerek erişilebiliyor. VPS'te UPLOADS_DIR gibi kalıcı bir yola
# ayarlayıp deploy.sh/backup.sh'a da eklemeniz gerekir.
# DEPOT_DIR="/var/www/lernzirkel/depot-storage"
