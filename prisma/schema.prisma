generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id           String         @id @default(uuid())
  name         String
  description  String?
  email        String?
  phone        String?
  openingHours OpeningHours[]
  teamMembers  TeamMember[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model OpeningHours {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 1 (Montag) bis 7 (Sonntag)
  openTime     String? // z.B. "09:00"
  closeTime    String? // z.B. "17:00"
  isClosed     Boolean    @default(false)
  note         String? // z.B. "Nur nach Terminvereinbarung"
}

enum CourseCategory {
  INTEGRATION
  SPRACHE
  NACHHILFE
  GRUNDBILDUNG
  BERUFSBEZOGEN
  PRUEFUNGSVORBEREITUNG
  ALPHABETISIERUNG
  ERSTORIENTIERUNG
  FRAUENKURSE
  FERIENKURSE
  WEITERBILDUNG
  ANDERE
}

model Course {
  id             String         @id @default(uuid())
  category       CourseCategory
  title          String
  description    String
  targetAudience String?
  requirements   String?
  costsInfo      String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean        @default(true)
  capacity       Int?           // null = sınırsız
  allowWaitlist  Boolean        @default(true)
  design         Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registrations  Registration[]
  translations   CourseTranslation[]
  surveyInvites    SurveyInvite[]
  surveyResponses  SurveyResponse[]

  @@index([isActive, category])
}

model CourseTranslation {
  id          String @id @default(uuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language    String // 'en', 'tr', 'ar'
  title       String
  description String @db.Text
  targetAudience String?
  requirements   String?
  costsInfo      String?

  @@unique([courseId, language])
}

enum ProjectStatus {
  AKTIV
  ABGESCHLOSSEN
}

model Project {
  id              String        @id @default(uuid())
  slug            String?       @unique
  title           String
  status          ProjectStatus @default(AKTIV)
  description     String
  goals           String?
  targetGroup     String?
  startDate       DateTime?
  endDate         DateTime?
  budget          String?
  fundingSource   String?
  partners        String?
  location        String?
  results         String?
  actionText      String?
  actionUrl       String?
  contactPersonId String?
  contactPerson   TeamMember?   @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  imageUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  translations    ProjectTranslation[]

  @@index([status])
}

model ProjectTranslation {
  id              String  @id @default(uuid())
  projectId       String
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language        String  // 'en', 'tr', 'ar'
  title           String
  description     String  @db.Text
  goals           String?
  targetGroup     String?
  results         String?
  actionText      String?

  @@unique([projectId, language])
}

model TeamMember {
  id           String      @id @default(uuid())
  name         String
  role         String
  bio          String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  email        String?
  phone        String?
  photoUrl     String?
  adminRole    String?     // "ADMIN" | "EDITOR" | "VIEWER" | null
  passwordHash String?     // PBKDF2 hash ("iterations.saltHex.hashHex"); null = admin girişi kapalı
  permissions  Json?       // { pages: bool, news: bool, courses: bool, team: bool, gallery: bool, projects: bool, design: bool }
  projects     Project[]
  assignedRegistrations Registration[] @relation("RegistrationAssignee")
  // Anket sonuçlarını kendi adına (anonim/aggregate) görmesi için eğitmene verilen
  // ayrı, parola gerektirmeyen "magic link" token'ı — admin paneli oturumuyla ilgisi yok.
  teacherReportToken      String?   @unique
  teacherReportTokenAt    DateTime?
}

model GalleryImage {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  category  String?
  createdAt DateTime @default(now())
}

model News {
  id          String    @id @default(uuid())
  title       String
  content     String
  publishDate DateTime  @default(now())
  archiveDate DateTime?
  imageUrl    String?
  design      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  translations NewsTranslation[]

  @@index([publishDate(sort: Desc)])
  @@index([archiveDate])
}

model NewsTranslation {
  id          String @id @default(uuid())
  newsId      String
  news        News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  language    String
  title       String
  content     String @db.Text

  @@unique([newsId, language])
}

model SiteSettings {
  id              String   @id @default("global")
  siteName        String   @default("Lernzirkel Ludwigshafen e.V.")
  description     String   @default("Bildung, Beratung und soziale Projekte")
  primaryColor    String   @default("#0F4761")
  primaryLight    String   @default("#1a6d92")
  secondaryColor  String   @default("#e8f4f8")
  accentColor     String   @default("#e63946")
  backgroundColor String   @default("#fbfbfb")
  foregroundColor String   @default("#333333")
  mutedColor      String   @default("#f1f1f1")
  headerConfig    Json?
  footerConfig    Json?
  designConfig    Json?
  marketingConfig Json?
  aiConfig        Json?
  securityConfig  Json?
  updatedAt       DateTime @default(now()) @updatedAt
}

model Page {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String?
  isPublished Boolean   @default(true)
  publishAt   DateTime? // dolu ve gelecekteyse, cron tetiklenene kadar taslak kalır
  parentId    String?
  parent      Page?     @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Page[]    @relation("PageHierarchy")
  order       Int       @default(0)
  sections    Section[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  translations PageTranslation[]

  // Tier 1: taslak/yayın ayrımı ve çakışma koruması
  contentVersion Int       @default(0) // bumped ONLY on publish; optimistic-lock conflict detection (updatedAt reused olamaz, draft autosave'de de otomatik artar)
  draftData      Json?     // { title, slug, description, parentId, order, isPublished, sections: [...] } — yayınlanmamış çalışma kopyası
  draftSavedAt   DateTime?

  // Tier 2: son yayınlayan bilgisi (düz string — TeamMember silinse/adı değişse de geçmiş kaydı bozulmaz)
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  // Tier 2: SEO paneli genişletmesi
  ogImage String?
  noIndex Boolean @default(false)

  @@index([parentId, order])
  @@index([isPublished])
}

// Tier 2: slug değiştiğinde otomatik oluşturulan yönlendirme kaydı
model Redirect {
  id        String   @id @default(uuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())
}

model PageTranslation {
  id          String @id @default(uuid())
  pageId      String
  page        Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language    String
  title       String
  description String?

  @@unique([pageId, language])
}

model Section {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  content   Json
  design    Json?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  translations SectionTranslation[]

  @@index([pageId, order])
}

model SectionTranslation {
  id          String  @id @default(uuid())
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  language    String
  content     Json

  @@unique([sectionId, language])
}

model Announcement {
  id              String    @id @default(uuid())
  title           String
  message         String
  isActive        Boolean   @default(true)
  isCloseable     Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  // Hedefleme: "ALL" | "HOME" | "SELECTED"
  targetScope     String    @default("ALL")
  targetPageSlugs String[]
  // Görünüm tipi: "banner" | "sticky-bar" | "toast" | "popup"
  type            String    @default("banner")
  // Konum: "top" | "bottom"
  position        String    @default("top")
  // Stil
  backgroundColor String    @default("#1a6d92")
  textColor       String    @default("#ffffff")
  borderColor     String    @default("transparent")
  fontSize        String    @default("14px")
  fontWeight      String    @default("normal")
  padding         String    @default("12px 16px")
  // İkon: "none" | "info" | "warning" | "megaphone"
  icon            String    @default("none")
  animation       String    @default("none")
  animationSpeed  String    @default("normal")
  showCountdown   Boolean   @default(false)
  duration        Int       @default(7)
  isInline        Boolean   @default(true)
  linkUrl         String?
  linkText        String?
  translations    Json?     // { "tr": { title, message, linkText }, "en": { ... }, "ar": { ... } }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// -----------------------------------------
// NEW MODELS FOR ADVANCED FEATURES & ADMIN APPROVALS
// -----------------------------------------

model Registration {
  id              String    @id @default(uuid())
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String?
  message         String?
  language        String    @default("de")
  status          String    @default("PENDING") // PENDING, APPROVED, CONTACTED, REJECTED
  isWaitlisted    Boolean   @default(false)
  source          String?   // Kampanya linki slug'ı (bkz. CampaignLink) — hangi afiş/kanaldan geldiği
  assignedToId    String?
  assignedTo      TeamMember? @relation("RegistrationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  surveyInvite    SurveyInvite?

  @@index([courseId, status])
  @@index([assignedToId])
  @@index([source])
}

// Saha/afiş/sosyal medya kampanyaları için izlenebilir kısa linkler. /go/[slug] üzerinden
// hedef URL'e yönlendirir, tıklamayı sayar ve bir çerez bırakarak kayıt formuna kadar
// kaynağı taşır (Registration.source). QR kodu admin panelinde bu linkten üretilir.
model CampaignLink {
  id             String    @id @default(uuid())
  slug           String    @unique
  label          String    // Admin için okunabilir isim, örn. "Okul Afişi - Ekim 2026"
  targetUrl      String    // Yönlendirilecek hedef, örn. /kurse/xxxx veya /kontakt
  platform       String    @default("other") // instagram, facebook, whatsapp, tiktok, other
  description    String?   // "Link in Bio" sayfasında kart altında gösterilen kısa açıklama
  showOnBioPage  Boolean   @default(false)
  clicks         Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

// -----------------------------------------
// KURS SONU ANKETİ (ANONİM MEMNUNİYET ANKETİ)
// -----------------------------------------

// Admin tarafından düzenlenebilen soru bankası. "section" anket formundaki iki bölümü
// belirler: kursiyerin eğitmeni mi yoksa kursun kendisini mi değerlendirdiği.
model SurveyQuestion {
  id           String   @id @default(uuid())
  section      String   // "LEHRER" | "KURS"
  type         String   // "RATING_5" | "NPS_0_10" | "TEXT" | "YES_NO"
  prompt       String   // varsayılan dil (de)
  translations Json?    // { tr: "...", en: "...", ar: "..." }
  isRequired   Boolean  @default(true)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([section, order])
}

// Her kursiyer-kurs çifti için tek kullanımlık davet/token. Kimin doldurup doldurmadığı
// (status/completedAt) burada görünür kalır — hatırlatma göndermek ve yanıt oranını
// hesaplamak için gerekli. AMA bu tablo SurveyResponse ile ASLA ilişkilendirilmez: bir
// kursiyerin anketi tamamladığını görmek, o kursiyerin hangi cevapları verdiğini göstermez.
model SurveyInvite {
  id              String       @id @default(uuid())
  token           String       @unique
  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  registrationId  String       @unique
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  teacherSnapshot String?
  language        String       @default("de")
  status          String       @default("PENDING") // PENDING, SENT, FAILED, OPENED, COMPLETED, EXPIRED
  sentAt          DateTime?
  openedAt        DateTime?
  completedAt     DateTime?
  remindersSent   Int          @default(0)
  lastReminderAt  DateTime?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  // Resend webhook ile gerçek teslimat takibi (Resend'in "gönderildi" demesi ≠ posta
  // kutusuna ulaştı). resendEmailId her (yeniden) gönderimde güncellenir — sadece EN SON
  // e-postanın teslimat durumunu tutarız, geçmiş gönderim denemelerini değil.
  resendEmailId    String?
  deliveryStatus   String?   // DELIVERED, BOUNCED, COMPLAINED, DELAYED
  deliveryStatusAt DateTime?

  @@index([courseId, status])
  @@index([resendEmailId])
}

// Anonim anket cevabı. Kasıtlı olarak registrationId/email/IP YOK — hiçbir alan bir
// kursiyere geri izlenemez. Soru metni de snapshot'lanır ki soru bankası sonradan
// değişse/silinse bile geçmiş cevaplar okunabilir kalsın.
model SurveyResponse {
  id                  String   @id @default(uuid())
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTitleSnapshot String
  categorySnapshot    String?
  teacherSnapshot     String?
  language            String
  answers             Json     // [{ questionId, section, type, prompt, value }]
  flagged             Boolean  @default(false) // açık uçlu cevapta uyarı kelimesi tespit edildi (admin triage)
  submittedAt         DateTime @default(now())

  @@index([courseId])
  @@index([submittedAt])
}

model EventLog {
  id        String   @id @default(uuid())
  eventName String   // e.g. "whatsapp_click", "phone_call", "grant_wizard_complete", "course_view"
  url       String
  locale    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g. "UPDATE_MARKETING_SETTINGS", "APPROVE_APPLICATION", "TOGGLE_AI"
  adminUser String   @default("Admin")
  details   Json?
  createdAt DateTime @default(now())
}


model ContactMessage {
  id        String   @id @default(uuid())
  topic     String
  firstName String
  lastName  String
  email     String
  phone     String?
  details   Json?
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model JobPosition {
  id          String   @id @default(uuid())
  title       String   // e.g. "Lehrkraft für Deutsch", "Praktikant im Bereich Marketing"
  type        String   // "LEHRER" | "PRAKTIKANT" | "OTHER"
  description String   // Details about the position
  requirements String? // requirements or qualifications
  location    String?  // e.g. "Ludwigshafen"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String   @default("ALLGEMEIN") // MFD, INTEGRATION, NACHHILFE, ALLGEMEIN
  tags        String?
  author      String?
  isPublished Boolean  @default(true)
  publishAt   DateTime? // dolu ve gelecekteyse, cron tetiklenene kadar taslak kalır
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  translations ArticleTranslation[]
}

model ArticleTranslation {
  id          String  @id @default(uuid())
  articleId   String
  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  language    String
  title       String
  excerpt     String?
  content     String  @db.Text

  @@unique([articleId, language])
}

// -----------------------------------------
// GENERIC CONTENT REVISION HISTORY (Faz A)
// -----------------------------------------

model ContentRevision {
  id        String   @id @default(uuid())
  modelName String   // e.g. "Page", "News", "Course", "Project", "Article"
  recordId  String
  data      Json     // record snapshot before the overwrite
  label     String?  // optional free-text note
  createdAt DateTime @default(now())

  @@index([modelName, recordId, createdAt(sort: Desc)])
}
